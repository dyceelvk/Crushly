# Copy to .env and fill in from your Supabase project
# (Project Settings → API), or from `supabase status` when running locally.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, local evaluation only: show "Explore the demo community" on the
# sign-in screen (requires the seed data). Off unless set to 1.
# EXPO_PUBLIC_DEMO_LOGIN=1

# Bot check (Cloudflare Turnstile). The SITE key is public and ships in the app.
# The SECRET key belongs in Supabase only — Authentication → Attack Protection.
# Leave blank and the app sends no captcha token, exactly as before; Supabase
# then refuses sign-in if its captcha toggle is on, which is the "auth is
# broken" state, not a silent pass.
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
