{
  "rewrites": [
    {
      "source": "/verification",
      "destination": "/"
    },
    {
      "source": "/v/:id",
      "destination": "/api/post-share?id=:id"
    },
    {
      "source": "/s/:id",
      "destination": "/api/space-share?id=:id"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
